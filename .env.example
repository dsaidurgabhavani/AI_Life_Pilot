# ========================================================
# AI LifePilot - Environment Configuration
# ========================================================

# Google Gemini API Key (Optional for basic local tools, required for generative AI coaching)
# Obtain a free API key at: https://aistudio.google.com/app/apikey
# If omitted, AI LifePilot operates using its built-in real action engine with live weather, web search, and task tools.
GEMINI_API_KEY=

# Preferred Gemini Model
# Options: gemini-3.1-flash-lite (fastest, recommended), gemini-3.5-flash-lite, gemini-3.5-flash, gemini-flash-lite-latest
GEMINI_MODEL=gemini-3.1-flash-lite

# Default User Timezone (e.g., Asia/Kolkata, America/New_York, Europe/London, UTC)
USER_DEFAULT_TIMEZONE=Asia/Kolkata

# Backend Server Host & Port
HOST=127.0.0.1
PORT=8000

# Frontend URL (optional, for explicit CORS restriction in production)
FRONTEND_URL=http://localhost:5173
