# ========================================================
# AI LifePilot - Environment Configuration
# ========================================================

# Google Gemini API Key (Optional)
# Obtain a free API key at: https://aistudio.google.com/app/apikey
# If omitted, AI LifePilot operates using its built-in local deterministic action engine.
GEMINI_API_KEY=

# Preferred Gemini Model (default: gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Backend Server Port (default: 8000)
PORT=8000

# Frontend URL (optional, for explicit CORS restriction in production)
# FRONTEND_URL=http://localhost:5173
